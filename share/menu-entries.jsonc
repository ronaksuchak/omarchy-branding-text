  // omarchy-branding-text:begin
  "appearance.branding": {"icon":"󰛖","label":"Branding"},
  "appearance.branding.settings": {"icon":"󰒓","label":"Settings…","action":"omarchy-launch-floating-terminal-with-presentation 'omarchy-branding-text ui'"},
  "appearance.branding.text": {"icon":"󰏫","label":"Change Text","action":"omarchy-launch-floating-terminal-with-presentation 'omarchy-branding-text set'"},
  "appearance.branding.apply": {"icon":"󰄬","label":"Apply Branding","action":"omarchy-launch-floating-terminal-with-presentation 'omarchy-branding-text apply'"},
  "appearance.branding.preview": {"icon":"󰈈","label":"Preview","action":"omarchy-launch-floating-terminal-with-presentation 'omarchy-branding-text preview'"},
  "appearance.branding.style": {"icon":"󰛖","label":"Style"},
  "appearance.branding.style.narrow": {"icon":"","label":"Narrow","checked":"[[ $(omarchy-branding-text get STYLE) == narrow ]]","action":"omarchy-launch-floating-terminal-with-presentation 'omarchy-branding-text style narrow'"},
  "appearance.branding.style.heavy": {"icon":"","label":"Heavy","checked":"[[ $(omarchy-branding-text get STYLE) == heavy ]]","action":"omarchy-launch-floating-terminal-with-presentation 'omarchy-branding-text style heavy'"},
  "appearance.branding.style.wide": {"icon":"","label":"Wide","checked":"[[ $(omarchy-branding-text get STYLE) == wide ]]","action":"omarchy-launch-floating-terminal-with-presentation 'omarchy-branding-text style wide'"},
  "appearance.branding.style.serif": {"icon":"","label":"Serif","checked":"[[ $(omarchy-branding-text get STYLE) == serif ]]","action":"omarchy-launch-floating-terminal-with-presentation 'omarchy-branding-text style serif'"},
  "appearance.branding.style.mono": {"icon":"","label":"Mono","checked":"[[ $(omarchy-branding-text get STYLE) == mono ]]","action":"omarchy-launch-floating-terminal-with-presentation 'omarchy-branding-text style mono'"},
  "appearance.branding.follow-theme": {"icon":"󰸌","label":"Follow Theme Colours","checked":"[[ $(omarchy-branding-text get FOLLOW_THEME) == true ]]","action":"omarchy-branding-text toggle FOLLOW_THEME"},
  "appearance.branding.surfaces": {"icon":"󰃖","label":"Surfaces"},
  "appearance.branding.surfaces.session-on": {"icon":"󰈈","label":"Screensaver and About On","when":"[[ $(omarchy-branding-text get SURFACES) != *session* ]]","action":"omarchy-launch-floating-terminal-with-presentation 'omarchy-branding-text surface session on'"},
  "appearance.branding.surfaces.session-off": {"icon":"󰈈","label":"Screensaver and About Off","when":"[[ $(omarchy-branding-text get SURFACES) == *session* ]]","action":"omarchy-launch-floating-terminal-with-presentation 'omarchy-branding-text surface session off'"},
  "appearance.branding.surfaces.login-on": {"icon":"󰟵","label":"Login Screen On","when":"[[ $(omarchy-branding-text get SURFACES) != *login* ]]","action":"omarchy-launch-floating-terminal-with-presentation 'omarchy-branding-text surface login on'"},
  "appearance.branding.surfaces.login-off": {"icon":"󰟵","label":"Login Screen Off","when":"[[ $(omarchy-branding-text get SURFACES) == *login* ]]","action":"omarchy-launch-floating-terminal-with-presentation 'omarchy-branding-text surface login off'"},
  "appearance.branding.surfaces.splash-on": {"icon":"󱐌","label":"Boot Splash On","when":"[[ $(omarchy-branding-text get SURFACES) != *splash* ]]","action":"omarchy-launch-floating-terminal-with-presentation 'omarchy-branding-text surface splash on'"},
  "appearance.branding.surfaces.splash-off": {"icon":"󱐌","label":"Boot Splash Off","when":"[[ $(omarchy-branding-text get SURFACES) == *splash* ]]","action":"omarchy-launch-floating-terminal-with-presentation 'omarchy-branding-text surface splash off'"},
  "appearance.branding.surfaces.bootmenu-on": {"icon":"󰇅","label":"Boot Menu On","when":"[[ $(omarchy-branding-text get SURFACES) != *bootmenu* ]]","action":"omarchy-launch-floating-terminal-with-presentation 'omarchy-branding-text surface bootmenu on'"},
  "appearance.branding.surfaces.bootmenu-off": {"icon":"󰇅","label":"Boot Menu Off","when":"[[ $(omarchy-branding-text get SURFACES) == *bootmenu* ]]","action":"omarchy-launch-floating-terminal-with-presentation 'omarchy-branding-text surface bootmenu off'"},
  "appearance.branding.reset": {"icon":"󰑓","label":"Reset Branding","action":"omarchy-launch-floating-terminal-with-presentation 'omarchy-branding-text reset'"}
  // omarchy-branding-text:end
